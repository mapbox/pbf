{
  "name": "pbf",
  "version": "5.2.0",
  "description": "a low-level, lightweight protocol buffers implementation in JavaScript",
  "main": "dist/pbf.js",
  "module": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./compile": "./compile.js",
    "./resolve": "./resolve.js"
  },
  "sideEffects": false,
  "scripts": {
    "bench": "node bench/bench.js",
    "pretest": "eslint *.js compile.js test/*.js test/fixtures/*.js bench/*.js bin/pbf && tsc && tsc -p test/types",
    "test": "node --test test/*.test.js",
    "cov": "node --test --experimental-test-coverage test/*.test.js",
    "build": "rolldown -c",
    "prepublishOnly": "npm run test && npm run build"
  },
  "files": [
    "bin",
    "dist",
    "index.js",
    "compile.js",
    "resolve.js",
    "index.d.ts",
    "compile.d.ts",
    "resolve.d.ts"
  ],
  "types": "index.d.ts",
  "bin": {
    "pbf": "bin/pbf"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mapbox/pbf.git"
  },
  "keywords": [
    "protocol",
    "buffer",
    "pbf",
    "protobuf",
    "binary",
    "format",
    "serialization",
    "encoder",
    "decoder"
  ],
  "author": "Konstantin Kaefer",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/mapbox/pbf/issues"
  },
  "homepage": "https://github.com/mapbox/pbf",
  "dependencies": {
    "protocol-buffers-schema": "^3.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-mourner": "^5.0.2",
    "protobufjs": "^8.8.1",
    "protocol-buffers": "^5.0.0",
    "rolldown": "^1.3.2",
    "typescript": "^7.0.2"
  }
}
